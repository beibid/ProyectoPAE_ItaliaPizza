<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="italiapizza.controlador.PedidoFormControlador">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Cliente: *"/>
        <ComboBox fx:id="comboClientePedido" prefWidth="260"/>
    </HBox>
    <Separator/>
    <Label text="Agregar productos:"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="comboProductoAgregar" prefWidth="200"/>
        <Label text="Cantidad:"/>
        <Spinner fx:id="spinnerCantidad" min="1" max="999" initialValue="1"
                 editable="true" prefWidth="80"/>
        <Button text="+ Agregar" onAction="#ejecutarAgregarProducto"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>
    <TableView fx:id="tablaDetallesPedido" prefHeight="200">
        <columns>
            <TableColumn fx:id="columnaProducto"   text="Producto"/>
            <TableColumn fx:id="columnaCantidad"   text="Cant."/>
            <TableColumn fx:id="columnaPrecioUnit" text="Precio Unit."/>
            <TableColumn fx:id="columnaSubtotal"   text="Subtotal"/>
        </columns>
    </TableView>
    <Button text="Quitar seleccionado" onAction="#ejecutarQuitarProducto"/>
    <Label fx:id="etiquetaTotalPedido" text="Total: $0.00" style="-fx-font-size: 16px;"/>
    <Label fx:id="etiquetaError" style="-fx-text-fill: red;"/>
    <HBox spacing="10">
        <Button text="Guardar Pedido" onAction="#ejecutarGuardarPedido"
                style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Cancelar" onAction="#ejecutarCancelar"/>
    </HBox>
</VBox>