<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="italiapizza.controlador.ValidacionInventarioControlador">
    <top>
        <VBox>
            <Label text="Selecciona un producto, ingresa la cantidad física y presiona Aplicar."
                   style="-fx-text-fill: #7f8c8d; -fx-padding: 8 0 0 10;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <Label text="Producto:"/>
                <ComboBox fx:id="comboProductoValidar" prefWidth="220"/>
                <Label text="Cantidad física:"/>
                <Spinner fx:id="spinnerCantidadFisica" min="0" max="99999" initialValue="0"
                         editable="true" prefWidth="100"/>
                <Button text="Aplicar" onAction="#aplicarValidacion"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaValidacion">
            <columns>
                <TableColumn fx:id="columnaNombreProducto"    text="Producto"/>
                <TableColumn fx:id="columnaExistenciaSistema" text="Sistema"/>
                <TableColumn fx:id="columnaExistenciaFisica"  text="Físico"/>
                <TableColumn fx:id="columnaDiferencia"        text="Diferencia"/>
            </columns>
        </TableView>
    </center>
</BorderPane>