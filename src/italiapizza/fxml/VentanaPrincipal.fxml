<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="italiapizza.controlador.VentanaPrincipalControlador">

    <top>
        <MenuBar style="-fx-background-color: #c0392b;">
            <Menu fx:id="menuAdministracion" text="Administración">
                <MenuItem text="👥 Usuarios"      onAction="#abrirGestionUsuarios"/>
                <SeparatorMenuItem/>
                <MenuItem text="🚪 Cerrar Sesión" onAction="#ejecutarCierreSesion"/>
            </Menu>
            <Menu fx:id="menuInventarios" text="Inventarios">
                <MenuItem text="📦 Productos"               onAction="#abrirGestionProductos"/>
                <MenuItem text="✔ Validación de Inventario" onAction="#abrirValidacionInventario"/>
            </Menu>
            <Menu text="Pedidos">
                <MenuItem text="🛒 Pedidos" onAction="#abrirGestionPedidos"/>
            </Menu>
        <Menu text="Ayuda">
            <MenuItem text="ℹ Acerca de" onAction="#mostrarAcercaDe"/>
        </Menu>
        </MenuBar>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="16">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>
            <Label text="🍕" style="-fx-font-size: 72px;"/>
            <Label fx:id="etiquetaBienvenida"
                   style="-fx-font-size: 22px; -fx-font-weight: BOLD; -fx-text-fill: #2c3e50;"/>
            <Label text="Selecciona una opción del menú para comenzar."
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="etiquetaEstado"
               style="-fx-background-color: #ecf0f1; -fx-padding: 4 8;"/>
    </bottom>
</BorderPane>
